GOOGLE_API_KEY=your_google_gemini_api_key_here
# Resource limits applied during upload, import, and indexing.
MAX_UPLOAD_SIZE_MB=50
MAX_IMPORT_ZIP_MEMBERS=100
MAX_IMPORT_ZIP_UNCOMPRESSED_MB=250
MAX_PDF_PAGES=200
PROCESSING_TIMEOUT_SECONDS=180
# Optional when using Ollama Offline mode. Start Ollama separately and pull the selected models.
# OLLAMA_HOST=http://localhost:11434
